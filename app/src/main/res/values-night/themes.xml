<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (dark). -->
    <style name="Base.Theme.CampusPay" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary_light</item>
        <item name="colorOnPrimary">#1E1B4B</item>
        <item name="colorPrimaryContainer">#312E81</item>
        <item name="colorOnPrimaryContainer">#E0E7FF</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#04231F</item>
        <item name="colorSecondaryContainer">#134E4A</item>
        <item name="colorOnSecondaryContainer">#CCFBF1</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">#262A35</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">#3F4756</item>
        <item name="colorOutlineVariant">#2C313C</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>