rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Organizer = users/{uid}.role == 'admin' (set by hand in Firebase console)
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User data BEFORE / AFTER the current write (batch/transaction)
    function userBefore(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data;
    }

    // An organizer may reward an event only if it has a reward configured
    // and it is their own event (events added by hand in the console have
    // no createdBy, so any organizer may reward those).
    function canRewardEvent(eid, credits) {
      let ev = get(/databases/$(database)/documents/events/$(eid)).data;
      return ev.credits == credits
        && (!('createdBy' in ev) || ev.createdBy == request.auth.uid);
    }
    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    match /users/{userId} {

      // AWARD: an organizer (never for themselves) may raise a student's
      // balance only if a brand-new attendance record for that student +
      // event is created in the SAME commit, and the balance increase equals
      // exactly the credits stored in that record.
      function isAward(uid) {
        let eid = request.resource.data.lastEventId;
        let att = /databases/$(database)/documents/attendance/$(uid + '_' + eid);
        return isAdmin()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['credits', 'lastEventId'])
          && eid is string
          && !exists(att)
          && getAfter(att).data.creditsAwarded
               == request.resource.data.credits - resource.data.credits
          && getAfter(att).data.awardedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.credits
               == request.resource.data.credits;
      }

      // DEBIT: you may only LOWER your own balance (sending credits).
      function isDebit() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['credits'])
          && request.resource.data.credits < resource.data.credits;
      }

      // INCOMING TRANSFER: someone else's balance may go up only if YOUR
      // balance goes down by exactly the same amount in the same commit.
      function isIncomingTransfer() {
        let amount = request.resource.data.credits - resource.data.credits;
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['credits'])
          && amount > 0
          && userAfter(request.auth.uid).credits
               == userBefore(request.auth.uid).credits - amount;
      }

      // Anyone signed in can read a profile (Send Credits, organizer scan)
      allow get: if signedIn();

      // Send Credits looks up the recipient by email with .limit(1)
      allow list: if signedIn() && request.query.limit <= 1;

      // Registration: only your own doc, always a student with 0 credits
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'credits'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'credits'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.role == 'student'
        && request.resource.data.credits == 0;

      // name / email / role are locked forever. Credits only move through:
      //  - your own debit (sending credits)
      //  - an organizer award backed by an attendance record
      //  - an incoming transfer matched by the sender's debit
      allow update: if signedIn()
        && request.resource.data.credits is int
        && request.resource.data.credits >= 0
        && (
             (isOwner(userId) && isDebit())
          || (!isOwner(userId) && (isAward(userId) || isIncomingTransfer()))
        );

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // events/{eventId}
    // ------------------------------------------------------------------
    match /events/{eventId} {
      allow read: if signedIn();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['title', 'description', 'credits', 'date', 'createdBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.credits is int
        && request.resource.data.credits > 0
        && request.resource.data.credits <= 10000
        && request.resource.data.date is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // registrations/{uid_eventId}
    // ------------------------------------------------------------------
    match /registrations/{registrationId} {

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['userId', 'eventId', 'eventTitle', 'registeredAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && registrationId == request.auth.uid + '_' + request.resource.data.eventId
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.registeredAt == request.time;

      // Students read their own; organizers check registration when scanning
      allow get: if signedIn()
        && (registrationId.matches(request.auth.uid + '_.+') || isAdmin());

      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }
    // ------------------------------------------------------------------
    // attendance/{studentUid_eventId}  (one reward per student per event)
    // Created ONLY by an organizer after scanning the student's QR.
    // ------------------------------------------------------------------
    match /attendance/{attendanceId} {

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['userId', 'eventId', 'eventTitle', 'creditsAwarded', 'awardedBy', 'attendedAt'])
        && request.resource.data.keys().hasAll(
             ['userId', 'eventId', 'creditsAwarded', 'awardedBy', 'attendedAt'])
        && request.resource.data.userId is string
        && request.resource.data.eventId is string
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.awardedBy == request.auth.uid
        && attendanceId == request.resource.data.userId + '_' + request.resource.data.eventId
        && exists(/databases/$(database)/documents/registrations/$(attendanceId))
        && canRewardEvent(request.resource.data.eventId, request.resource.data.creditsAwarded)
        && request.resource.data.attendedAt == request.time;

      // Students read their own; organizers check "already rewarded"
      allow get: if signedIn()
        && (attendanceId.matches(request.auth.uid + '_.+') || isAdmin());

      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // transactions/{id}  (credit history ledger - create-only)
    // ------------------------------------------------------------------
    match /transactions/{txId} {

      // Earn entry: written by the organizer, only alongside a brand-new
      // attendance record that carries the same credits
      function isEarnEntry() {
        let d = request.resource.data;
        let att = /databases/$(database)/documents/attendance/$(d.userId + '_' + d.eventId);
        return d.type == 'earn'
          && d.keys().hasOnly(
               ['type', 'userId', 'eventId', 'eventTitle', 'credits', 'description', 'createdAt'])
          && d.userId is string
          && d.eventId is string
          && d.userId != request.auth.uid
          && isAdmin()
          && !exists(att)
          && getAfter(att).data.creditsAwarded == d.credits
          && getAfter(att).data.awardedBy == request.auth.uid;
      }

      // Transfer (sender side): your balance must drop by exactly `credits`
      function isTransferOutEntry() {
        let d = request.resource.data;
        return d.type == 'transfer'
          && d.direction == 'out'
          && d.keys().hasOnly(
               ['type', 'direction', 'userId', 'counterpartyEmail', 'credits', 'description', 'createdAt'])
          && d.userId == request.auth.uid
          && userAfter(request.auth.uid).credits
               == userBefore(request.auth.uid).credits - d.credits;
      }

      // Transfer (recipient side): that student's balance must rise by exactly `credits`
      function isTransferInEntry() {
        let d = request.resource.data;
        return d.type == 'transfer'
          && d.direction == 'in'
          && d.keys().hasOnly(
               ['type', 'direction', 'userId', 'counterpartyEmail', 'credits', 'description', 'createdAt'])
          && d.userId != request.auth.uid
          && userAfter(d.userId).credits
               == userBefore(d.userId).credits + d.credits;
      }

      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.credits is int
        && request.resource.data.credits > 0
        && request.resource.data.createdAt == request.time
        && (isEarnEntry() || isTransferOutEntry() || isTransferInEntry());

      allow update, delete: if false;
    }

    // Everything else is denied by default
  }
}