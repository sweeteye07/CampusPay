rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userBefore(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data;
    }

    function canRewardEvent(eid, credits) {
      let ev = get(/databases/$(database)/documents/events/$(eid)).data;
      return ev.credits == credits
        && (!('createdBy' in ev) || ev.createdBy == request.auth.uid);
    }

    match /users/{userId} {

      function isAward(uid) {
        let eid = request.resource.data.lastEventId;
        let att = /databases/$(database)/documents/attendance/$(uid + '_' + eid);

        return isAdmin()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['credits', 'lastEventId'])
          && eid is string
          && !exists(att)
          && getAfter(att).data.creditsAwarded
               == request.resource.data.credits - resource.data.credits
          && getAfter(att).data.awardedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.credits
               == request.resource.data.credits;
      }

      function isDebit() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['credits'])
          && request.resource.data.credits < resource.data.credits;
      }

      function isNameUpdate() {
        return isOwner(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
      }
      function isIncomingTransfer() {
        let amount = request.resource.data.credits - resource.data.credits;

        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['credits'])
          && amount > 0
          && userAfter(request.auth.uid).credits
               == userBefore(request.auth.uid).credits - amount;
      }

      allow get: if signedIn();

      allow list: if signedIn() && request.query.limit <= 1;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'credits'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'credits'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.role == 'student'
        && request.resource.data.credits == 0;

      allow update: if signedIn()
        && request.resource.data.credits is int
        && request.resource.data.credits >= 0
        && (
             isNameUpdate()
          || (isOwner(userId) && isDebit())
          || (!isOwner(userId) && (isAward(userId) || isIncomingTransfer()))
        );

      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['title', 'description', 'credits', 'date', 'createdBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.credits is int
        && request.resource.data.credits > 0
        && request.resource.data.credits <= 10000
        && request.resource.data.date is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Only the owning organizer (or any organizer for owner-less
      // console events) may edit; createdBy/createdAt are immutable.
      allow update: if isAdmin()
        && (!('createdBy' in resource.data)
            || resource.data.createdBy == request.auth.uid)
        && request.resource.data.keys().hasOnly(
             ['title', 'description', 'credits', 'date', 'createdBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.credits is int
        && request.resource.data.credits > 0
        && request.resource.data.credits <= 10000
        && request.resource.data.date is string
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // Same ownership rule for deletes so one organizer
      // cannot remove another organizer's event.
      allow delete: if isAdmin()
        && (!('createdBy' in resource.data)
            || resource.data.createdBy == request.auth.uid);
    }

    match /registrations/{registrationId} {

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['userId', 'eventId', 'eventTitle', 'registeredAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && registrationId == request.auth.uid + '_' + request.resource.data.eventId
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.registeredAt == request.time;

      allow get: if signedIn()
        && (registrationId.matches(request.auth.uid + '_.+') || isAdmin());

      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }
    match /attendance/{attendanceId} {

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['userId', 'eventId', 'eventTitle', 'creditsAwarded', 'awardedBy', 'attendedAt'])
        && request.resource.data.keys().hasAll(
             ['userId', 'eventId', 'creditsAwarded', 'awardedBy', 'attendedAt'])
        && request.resource.data.userId is string
        && request.resource.data.eventId is string
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.awardedBy == request.auth.uid
        && attendanceId == request.resource.data.userId + '_' + request.resource.data.eventId
        && exists(/databases/$(database)/documents/registrations/$(attendanceId))
        && canRewardEvent(request.resource.data.eventId, request.resource.data.creditsAwarded)
        && request.resource.data.attendedAt == request.time;

      allow get: if signedIn()
        && (attendanceId.matches(request.auth.uid + '_.+') || isAdmin());

      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    match /transactions/{txId} {

      function isEarnEntry() {
        let d = request.resource.data;
        let att = /databases/$(database)/documents/attendance/$(d.userId + '_' + d.eventId);

        return d.type == 'earn'
          && d.keys().hasOnly(
               ['type', 'userId', 'eventId', 'eventTitle', 'credits', 'description', 'createdAt'])
          && d.userId is string
          && d.eventId is string
          && d.userId != request.auth.uid
          && isAdmin()
          && !exists(att)
          && getAfter(att).data.creditsAwarded == d.credits
          && getAfter(att).data.awardedBy == request.auth.uid;
      }

      function isTransferOutEntry() {
        let d = request.resource.data;

        return d.type == 'transfer'
          && d.direction == 'out'
          && d.keys().hasOnly(
               ['type', 'direction', 'userId', 'counterpartyEmail', 'credits', 'description', 'createdAt'])
          && d.userId == request.auth.uid
          && userAfter(request.auth.uid).credits
               == userBefore(request.auth.uid).credits - d.credits;
      }

      function isTransferInEntry() {
        let d = request.resource.data;

        return d.type == 'transfer'
          && d.direction == 'in'
          && d.keys().hasOnly(
               ['type', 'direction', 'userId', 'counterpartyEmail', 'credits', 'description', 'createdAt'])
          && d.userId != request.auth.uid
          && userAfter(d.userId).credits
               == userBefore(d.userId).credits + d.credits;
      }

      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.credits is int
        && request.resource.data.credits > 0
        && request.resource.data.createdAt == request.time
        && (isEarnEntry() || isTransferOutEntry() || isTransferInEntry());

      allow update, delete: if false;
    }
  }
}